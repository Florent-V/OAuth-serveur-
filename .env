# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Mettez les vraies valeurs dans .env.local (non versionné) ou dans les variables d'environnement.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

# Nom affiché dans l'interface
SITE_NAME="Mon compte"

# IP(s) du reverse proxy (ex. "127.0.0.1,REMOTE_ADDR" ou "private_ranges")
TRUSTED_PROXIES=private_ranges

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> league/oauth2-server-bundle ###
# Paire de clés RSA : php bin/console league:oauth2-server:generate-keypair
OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/jwt/private.pem
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# À définir dans .env.local : OAUTH_PASSPHRASE (phrase de passe de la clé privée)
# et OAUTH_ENCRYPTION_KEY (générer avec : php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;')
OAUTH_PASSPHRASE=
OAUTH_ENCRYPTION_KEY=
# Durée de vie des access tokens (format ISO 8601 : PT15M = 15 minutes)
OAUTH_ACCESS_TOKEN_TTL=PT15M
###< league/oauth2-server-bundle ###

###> symfony/mailer ###
# Brevo : MAILER_DSN=brevo+api://CLE_API@default  (ou brevo+smtp://LOGIN:CLE_SMTP@default)
MAILER_DSN=null://null
###< symfony/mailer ###

# Expéditeur des e-mails (adresse validée dans Brevo)
MAILER_FROM_EMAIL=no-reply@mydomain.com
MAILER_FROM_NAME="Mon compte"

# MFA par e-mail (code à 6 chiffres)
MFA_ENABLED=1
# Durée pendant laquelle un appareil de confiance n'a plus besoin de code (secondes ; 2592000 = 30 jours)
MFA_TRUSTED_DEVICE_LIFETIME=2592000
