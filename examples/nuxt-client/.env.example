NUXT_OAUTH_SERVER_URL=http://localhost:8080
NUXT_OAUTH_CLIENT_ID=nuxt
NUXT_OAUTH_CLIENT_SECRET=
NUXT_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# Clé publique du serveur (make public-key), sur une ligne ou entre guillemets avec retours à la ligne
NUXT_OAUTH_PUBLIC_KEY=
# Au moins 32 caractères : openssl rand -hex 32
NUXT_SESSION_PASSWORD=
