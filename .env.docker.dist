# Configuration de PRODUCTION (Docker).
#   cp .env.docker.dist .env.docker   puis remplir les valeurs (ne pas versionner .env.docker).
# Générer une valeur aléatoire : openssl rand -hex 32

# --- Docker ---
# Port d'écoute du conteneur sur la machine (le Caddy de l'hôte y redirige oauth.mydomain.com)
HTTP_PORT=8080
HTTP_BIND=127.0.0.1
IMAGE_NAME=oauth-server
IMAGE_TAG=latest

# --- Base de données PostgreSQL ---
POSTGRES_VERSION=16
POSTGRES_DB=oauth
POSTGRES_USER=oauth
POSTGRES_PASSWORD=

# --- Application ---
# Au moins 32 caractères : openssl rand -hex 32
APP_SECRET=
DEFAULT_URI=https://oauth.mydomain.com
SITE_NAME="Mon compte"
# Le Caddy de l'hôte arrive depuis le réseau Docker (plage privée)
TRUSTED_PROXIES=private_ranges

# --- OAuth2 ---
# Phrase de passe de la clé privée RSA (générée automatiquement au premier démarrage)
OAUTH_PASSPHRASE=
# Clé de chiffrement des codes d'autorisation et refresh tokens
OAUTH_ENCRYPTION_KEY=
OAUTH_ACCESS_TOKEN_TTL=PT15M

# --- E-mails (Brevo) ---
# Clé API Brevo (SMTP & API > Clés API) :
MAILER_DSN=brevo+api://VOTRE_CLE_API@default
# Expéditeur (doit être un expéditeur validé dans Brevo)
MAILER_FROM_EMAIL=no-reply@mydomain.com
MAILER_FROM_NAME="Mon compte"

# --- MFA ---
MFA_ENABLED=1
# 2592000 secondes = 30 jours sans code sur un appareil de confiance
MFA_TRUSTED_DEVICE_LIFETIME=2592000
