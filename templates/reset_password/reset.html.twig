{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe – {{ site_name }}{% endblock %}

{% block body %}
    <h1>Nouveau mot de passe</h1>
    <p class="subtitle">Il servira pour toutes vos applications. Vous serez déconnecté de tous vos appareils.</p>

    {{ form_start(form) }}
        {{ form_row(form.plainPassword) }}
        <button class="btn" type="submit">Enregistrer le mot de passe</button>
    {{ form_end(form) }}
{% endblock %}
